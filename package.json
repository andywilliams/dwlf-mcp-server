{
  "name": "@dwlf/mcp-server",
  "version": "0.63.0",
  "mcpName": "uk.co.dwlf/mcp-server",
  "description": "MCP server for DWLF market analysis platform — exposes market data, indicators, signals, strategies, backtests, portfolio, trade journal, and more as AI-accessible tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dwlf-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/hosted",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:infra": "cd infra && npm ci && npm test",
    "gen:spt-routes": "node scripts/gen-spt-routes.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dwlf",
    "trading",
    "market-data",
    "ai-tools",
    "claude",
    "cursor",
    "vscode"
  ],
  "author": "DWLF <hello@dwlf.co.uk>",
  "license": "MIT",
  "homepage": "https://www.dwlf.co.uk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andywilliams/dwlf-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/andywilliams/dwlf-mcp-server/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "axios": "^1.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1162.0",
    "@aws-sdk/client-kms": "^3.1162.0",
    "@aws-sdk/client-ssm": "^3.1162.0",
    "@types/node": "^25.1.0",
    "jose": "^6.2.15",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
